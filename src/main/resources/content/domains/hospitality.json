    {
      "id": "hospitality-control",
      "title": "What MySQL guarantees — and what the service must validate",
      "type": "table",
      "columns": [
        "Rule",
        "Enforced by SQL?",
        "Architectural takeaway"
      ],
      "rows": [
        [
          "Valid references and protected deletes",
          "Yes — 16 foreign keys, ON DELETE RESTRICT",
          "Referenced records cannot be arbitrarily removed while dependents exist."
        ],
        [
          "Positive reservation party size and valid time window",
          "Yes — CHECK party_size > 0 and end > start",
          "Bad individual row values are rejected."
        ],
        [
          "Unique tables, menu SKUs and outlet codes",
          "Yes — composite UNIQUE keys within their stated scopes",
          "Names and codes remain unique within the defined parent context."
        ],
        [
          "No double booking for a table/time window",
          "Not by the uploaded DDL",
          "Requires transactional availability checks, locking/concurrency policy or equivalent service enforcement."
        ],
        [
          "Member in good standing and permitted guest count",
          "Not by the uploaded DDL",
          "Requires a live Membership check and business policy."
        ],
        [
          "Tax calculation, POS totals and receipt posting",
          "Not fully enforced by the supplied DDL",
          "Application/integration rules determine amounts, payment state, outbox events and GL/AR flow."
        ],
        [
          "Event capacity cannot be exceeded",
          "Not by the uploaded DDL",
          "Requires booking-count or seat-allocation rules and concurrency protection."
        ]
      ]
    },
    {
      "id": "hospitality-video-guide",
      "title": "Recording guide · from a restaurant table to the general ledger",
      "type": "table",
      "columns": [
        "Chapter",
        "What to demonstrate",
        "Key takeaway"
      ],
      "rows": [
        [
          "01 · Establish the business context",
          "Show the live Hospitality navigation, outlets, table inventory and member standing",
          "The ERP serves business operations, not just pages and CRUD APIs."
        ],
        [
          "02 · Explain the ERD",
          "Trace outlet → table → reservation, then menu → POS order → POS order line",
          "A relational model expresses business relationships."
        ],
        [
          "03 · Make a reservation",
          "Use the existing reservation demo and discuss overlapping bookings",
          "Database FKs do not replace temporal business checks."
        ],
        [
          "04 · Complete the bill",
          "Open an order, select menu items, explain tax and member-account tender",
          "A POS transaction contains financial meaning."
        ],
        [
          "05 · Follow the money",
          "Explain the accounting event to AR/GL and the matching receipt or outstanding balance",
          "Every front-office operation has a back-office consequence."
        ],
        [
          "06 · Club events",
          "Show an event and attendee booking, explain capacity and permissions",
          "One platform serves restaurants and scheduled club experiences."
        ]
      ]
    },
