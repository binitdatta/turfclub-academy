      "id": "concepts",
      "title": "Key concepts",
      "type": "terms",
      "terms": [
        {
          "term": "Outlet",
          "definition": "GRILL Paddock Grill, BAR Winners Bar, PAVILION Grandstand Pavilion, each with tables and a menu."
        },
        {
          "term": "Reservation",
          "definition": "HELD → CONFIRMED → SEATED → COMPLETED, or CANCELLED / NO_SHOW."
        },
        {
          "term": "POS order",
          "definition": "OPEN → SUBMITTED → PAID, or VOID; tender CASH, CARD or MEMBER_ACCOUNT."
        },
        {
          "term": "Club event",
          "definition": "DRAFT → PUBLISHED → SOLD_OUT / COMPLETED / CANCELLED, with capacity and price per place."
        }
      ]
    },
