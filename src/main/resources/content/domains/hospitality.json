      "id": "hospitality-explained",
      "title": "Hospitality as a business: three everyday journeys",
      "type": "table",
      "columns": [
        "Journey",
        "What the club staff does",
        "What the ERP records",
        "Where finance becomes involved"
      ],
      "rows": [
        [
          "Restaurant reservation",
          "Select an outlet and available table for a party and time slot",
          "outlet → dining_table → reservation; the customer may be a member or guest",
          "A reservation is not by itself proof that revenue has been earned"
        ],
        [
          "Restaurant point of sale",
          "Take a food or beverage order, calculate each line and collect payment or charge the member",
          "menu_item + pos_order + pos_order_line; linked to reservation where appropriate",
          "Sale can generate revenue, tax, receipt or member-account receivable via accounting events"
        ],
        [
          "Club event",
          "Schedule an event, manage attendance and accept bookings",
          "club_event → event_booking; bookings may identify members or guests",
          "Event fees or other billed services may create an AR invoice or receipt"
        ]
      ]
    },
